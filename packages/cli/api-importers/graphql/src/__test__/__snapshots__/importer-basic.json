          }
        },
        "UpdatePostStatusRequest": {
          "properties": {
            "id": "string",
            "status": "PostStatus"
          }
        }
      },
      "service": {
        "auth": false,
        "base-path": "",
        "endpoints": {
          "user": {
            "auth": false,
            "method": "POST",
            "path": "",
            "request": {
              "body": "UserRequest"
            },
            "response": "optional<User>"
          },
          "users": {
            "auth": false,
            "method": "POST",
            "path": "",
            "request": {
              "body": "UsersRequest"
            },
            "response": "list<User>"
          },
          "post": {
            "auth": false,
            "method": "POST",
            "path": "",
