            "isActive": "optional<boolean>"
          }
        },
        "UserRequest": {
          "properties": {
            "id": "string"
          }
        },
        "UsersRequest": {
          "properties": {
            "filter": "optional<UserFilter>",
            "limit": "optional<integer>",
            "offset": "optional<integer>"
          }
        },
        "PostRequest": {
          "properties": {
            "id": "string"
          }
        },
        "PostsRequest": {
          "properties": {
            "status": "optional<PostStatus>",
            "limit": "optional<integer>"
          }
        },
        "SearchRequest": {
          "properties": {
            "query": "string"
          }
        },
        "CreateUserRequest": {
          "properties": {
            "input": "CreateUserInput"
          }
        },
        "UpdateUserRequest": {
          "properties": {
            "id": "string",
            "name": "optional<string>",
            "email": "optional<string>",
            "role": "optional<UserRole>"
          }
        },
        "DeleteUserRequest": {
          "properties": {
            "id": "string"
          }
        },
        "CreatePostRequest": {
          "properties": {
