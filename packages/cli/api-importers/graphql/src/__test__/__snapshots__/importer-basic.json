      "strategy": "status-code"
    }
  },
  "packageMarkerFile": {},
  "definitionFiles": {
    "graphql/__package__.yml": {
      "types": {
        "User": {
          "properties": {
            "id": "string",
            "uuid": "string",
            "name": "string",
            "email": "optional<string>",
            "age": "optional<integer>",
            "balance": "optional<string>",
            "isActive": "boolean",
            "role": "UserRole",
            "posts": "list<Post>",
