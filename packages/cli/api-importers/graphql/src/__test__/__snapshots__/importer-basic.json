            "publishedAt": "optional<datetime>",
            "viewCount": "optional<string>"
          }
        },
        "UserRole": {
          "enum": [
            "ADMIN",
            "USER",
            "GUEST"
          ]
        },
        "PostStatus": {
          "enum": [
            "DRAFT",
            "PUBLISHED",
            "ARCHIVED"
          ]
        },
        "CreateUserInput": {
          "properties": {
            "name": "string",
            "email": "string",
            "role": "optional<UserRole>"
          }
        },
        "CreatePostInput": {
          "properties": {
